[Unit]
Description=Defrag servers (native)
After=network-online.target
Wants=network-online.target

[Service]
Type=forking
WorkingDirectory=/home/q3df/dfsv
ExecStart=/home/q3df/dfsv/start-servers.sh
#ExecStop=/home/q3df/dfsv/stop-native.sh
User=q3df
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target